# Optional Windows host port overrides. Copy to .env and adjust for this host.
# Container ports and the TAK CoreConfig.xml connector ports remain unchanged.
# ATAK Data Packages uses takbox.local:8443; changing only this mapping breaks downloads.
# Set TAK_BIND_IP to the current Windows Wi-Fi or hotspot IPv4 address.
# Set TAK_ALLOWED_SUBNET to the client network allowed by the firewall scripts.
TAK_BIND_IP=192.168.137.1
TAK_ALLOWED_SUBNET=192.168.137.0/24
TAK_HTTPS_HOST_PORT=8443
SHARE_PUBLIC_HOST_PORT=10065
SHARE_ADMIN_HOST_PORT=10066
