logLevel: info
authMethod: internal
authInternalUsers:
  - user: atak-publisher
    pass: __PUBLISH_PASSWORD__
    ips: []
    permissions:
      - action: publish
        path: '~^(live/.+|test)$'
  - user: atak-viewer
    pass: __READ_PASSWORD__
    ips: []
    permissions:
      - action: read
        path: '~^(live/.+|test)$'
  - user: tak-console
    pass: __API_PASSWORD__
    ips: []
    permissions:
      - action: api
__DYNAMIC_USERS__

rtsp: true
# TCP only: Docker Desktop on Windows rewrites the UDP source port of published
# ports, so MediaMTX cannot match RTP/RTCP to the SETUP client_port and the
# session times out. See docs/mediamtx/server.md.
rtspTransports: [tcp]
rtspEncryption: optional
rtspAddress: :8554
rtspsAddress: :8322
rtpAddress: :8000
rtcpAddress: :8001
srtpAddress: :8004
srtcpAddress: :8005
rtspServerKey: /certs/mediamtx-server.key.pem
rtspServerCert: /certs/mediamtx-fullchain.pem
rtspAuthMethods: [basic]

rtmp: false
hls: false
webrtc: false
srt: false
moq: false
api: true
apiAddress: :9997
metrics: false
pprof: false
playback: false

paths:
  '~^(live/.+|test)$':
    source: publisher
    rtspDemuxMpegts: true
